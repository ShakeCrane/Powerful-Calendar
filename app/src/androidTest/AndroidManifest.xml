<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="${applicationId}.androidtest.permission.READ_SYNTHETIC_BACKUP"
        android:protectionLevel="signature" />
    <application>
        <activity
            android:name="dev.powerfulcalendar.reminders.D05ProbeActivity"
            android:exported="true"
            android:label="D05 isolated alarm probe"
            android:taskAffinity="dev.powerfulcalendar.test.d05probe"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <receiver
            android:name="dev.powerfulcalendar.reminders.D05ProbeReceiver"
            android:exported="false" />
        <provider
            android:name="dev.powerfulcalendar.interop.RevocableSafTestProvider"
            android:authorities="${applicationId}.androidtest.revocable-saf"
            android:exported="true"
            android:readPermission="${applicationId}.androidtest.permission.READ_SYNTHETIC_BACKUP"
            android:grantUriPermissions="true" />
        <provider
            android:name="dev.powerfulcalendar.interop.RestoreFailureDocumentsProvider"
            android:authorities="${applicationId}.androidtest.backup-documents"
            android:exported="true"
            android:permission="android.permission.MANAGE_DOCUMENTS"
            android:grantUriPermissions="true">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
